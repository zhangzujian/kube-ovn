+     * SB switch is enabled and during an explicitly coordinated disable.
+     * The node owner must install its independent protection before setting
+     * these local external IDs and clear them only after owned cleanup. */
+    if (cfg) {
+        unsigned int mark = smap_get_uint(&cfg->external_ids,
+                                          "ovn-ipsec-protection-mark", 0);
+        unsigned int reqid = smap_get_uint(&cfg->external_ids,
+                                           "ovn-ipsec-protection-reqid", 0);
+        if (mark && reqid) {
+            smap_add_format(&options, "egress_pkt_mark", "%u", mark);
+            if (sbg->ipsec) {
+                smap_add_format(&options, "ipsec_mark_out", "%u/0xffffffff",
+                                mark);
+                smap_add_format(&options, "ipsec_reqid", "%u", reqid);
+            }
+        }
+    }
