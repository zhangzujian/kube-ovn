# syntax=docker/dockerfile:1
# CI candidate built from fixed sources with the production output-protection patch.
ARG CANDIDATE_IMAGE
FROM ubuntu:26.04 AS builder
USER 0
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN apt-get update && apt-get install -y --no-install-recommends \
    autoconf automake bison build-essential ca-certificates curl flex libtool patch pkg-config libssl-dev \
    python3-setuptools python3-sortedcontainers
WORKDIR /src
RUN mkdir ovs ovn && \
    curl -fsSL https://github.com/openvswitch/ovs/archive/4a04136154d85ca6b64249fc85e25833b4a489ee.tar.gz | tar -xz --strip-components=1 -C ovs && \
    curl -fsSL https://github.com/ovn-org/ovn/archive/28ed48957d637a7bc149b9272240303d0ad8e0c5.tar.gz | tar -xz --strip-components=1 -C ovn
COPY patches/ovn-controller-propagate-ipsec-protection.patch /src/protection.patch
RUN cd ovs && ./boot.sh && \
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var && make -j2
RUN cd ovn && patch -p1 < /src/protection.patch && \
    sed -i -E 's/^(AC_INIT\(\[?ovn\]?, \[?[^],)]+)(\]?)(,.*)$/\1+g28ed48957d63\2\3/' configure.ac && \
    ./boot.sh && \
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var \
    --with-ovs-source=/src/ovs --with-ovs-build=/src/ovs && \
    make -j2
FROM ${CANDIDATE_IMAGE}
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
COPY --from=builder /src/ovn/controller/ovn-controller /usr/bin/ovn-controller
# Keep the internal version check enabled. The pinned source must match the
# northd package already shipped by the candidate base, including its suffix.
RUN ovn-controller --version | grep -F '26.03.4+g28ed48957d63' && \
    ovn-northd --version | grep -F '26.03.4+g28ed48957d63' && \
    ovn-controller --version | grep -Fx 'IPsec output protection version 1'
